# Frontend environment variables
# IMPORTANT: Do not commit real secrets. Copy this file to .env and fill values locally.

# Backend base URL (e.g., http://localhost:3001 or https://api.example.com)
REACT_APP_BACKEND_URL=

# Compatibility fallback (not required if BACKEND_URL is set)
REACT_APP_API_BASE=

# Optional: Frontend absolute URL (used by auth/email redirects)
REACT_APP_FRONTEND_URL=

# Optional: Websocket URL if used elsewhere
REACT_APP_WS_URL=

# Standard flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
