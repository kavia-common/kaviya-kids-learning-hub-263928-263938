# Allow binding to all interfaces for external hosts (e.g., beta.kavia.ai) to reach the CRA dev server
HOST=0.0.0.0

# Explicitly allow the beta.kavia.ai host via CRA host check bypass (dev only)
# Using CRA legacy env to skip host header validation to avoid "Invalid Host Header" during previews/tunnels.
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Keep HTTPS off for the dev server itself; rely on upstream HTTPS termination if any.
# HTTPS=false

# Note: Axios baseURL is configured within src/api/client.js to use relative '/api' so it leverages the proxy above.
